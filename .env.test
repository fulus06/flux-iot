# FLUX IOT 测试环境配置
# 使用方法: source .env.test 或在测试命令前加载

# PostgreSQL 数据库连接
DATABASE_URL=postgres://postgres:postgres@localhost:5432/flux_test

# MQTT 配置
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# 服务器配置
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# 日志级别
RUST_LOG=info,flux_server=debug,flux_mqtt=debug,flux_device=debug

# 测试超时（毫秒）
RUST_TEST_TIME_UNIT=5000
RUST_TEST_THREADS=4

# 测试数据库初始化
# 运行前执行: psql -U postgres -c "CREATE DATABASE flux_test;"
# 初始化表: psql -U postgres -d flux_test -f scripts/init_test_db.sql
